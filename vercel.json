{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "",
    "buildCommand": "node scripts/build-vercel.mjs",
    "outputDirectory": "vercel-public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30
        }
    },
    "routes": [
        { "src": "/(?:.*\\.php|\\..*)(?:/.*)?", "status": 404 },
        { "src": "/", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
